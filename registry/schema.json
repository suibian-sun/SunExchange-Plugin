{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["extensions"],
  "properties": {
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "platforms", "category", "repo", "description", "releases"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["unibot", "server"] },
          "platforms": { "type": "array", "items": { "type": "string", "enum": ["netease", "java", "bedrock", "all"] } },
          "category": { "type": "string" },
          "author": { "type": "string" },
          "repo": { "type": "string" },
          "description": { "type": "string" },
          "official": { "type": "boolean" },
          "icon": { "type": "string" },
          "releases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "asset_url"],
              "properties": {
                "version": { "type": "string" },
                "asset_url": { "type": "string" },
                "sha256": { "type": "string" },
                "unibot_version": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}